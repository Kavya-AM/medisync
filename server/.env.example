# --- required ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medisync
JWT_SECRET=change-this-long-random-string
CLIENT_URL=http://localhost:5173
CLINIC_TZ=Asia/Kolkata

# --- optional: every feature below falls back to a safe demo mode when its keys are empty ---
# AI symptom checker (Anthropic API). Empty = keyword rules.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Razorpay test keys (dashboard.razorpay.com > Settings > API keys). Empty = demo payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Twilio SMS for the SOS button. Empty = message is only printed in the server log.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Email for password reset. Empty = the reset link is printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediSync <no-reply@medisync.app>
# Firebase push (paste the service-account JSON on ONE line). Empty = push disabled.
FIREBASE_SERVICE_ACCOUNT=
# Video rooms. Default is the public Jitsi server.
JITSI_URL=https://meet.jit.si
